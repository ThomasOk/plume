# Server
SERVER_PORT=3035
SERVER_HOST=localhost
SERVER_AUTH_SECRET=your-super-secret-key-here

# Database
SERVER_POSTGRES_URL=postgresql://user:password@localhost:5432/project_db

# Auth - public URL of this server (used by Better Auth for callbacks)
BETTER_AUTH_URL=http://localhost:3035

# CORS / Trusted origins - public URL of the frontend
PUBLIC_WEB_URL=http://localhost:8085

# Google OAuth (optional - leave empty to disable)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudflare R2 Storage
SERVER_R2_ACCOUNT_ID=your-account-id
SERVER_R2_ACCESS_KEY_ID=your-access-key-id
SERVER_R2_SECRET_ACCESS_KEY=your-secret-access-key
SERVER_R2_BUCKET_NAME=your-bucket-name
SERVER_R2_PUBLIC_URL=https://your-bucket.your-account.r2.cloudflarestorage.com
SERVER_R2_UPLOAD_SIZE_LIMIT_MB=30
